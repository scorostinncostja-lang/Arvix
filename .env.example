# Telegram
BOT_TOKEN=
OWNER_ID=

# Публичный домен. На VPS — реальный домен (Caddy сам выпустит TLS через Let's Encrypt).
# Локально можно оставить localhost — Caddy поднимет self-signed сертификат.
DOMAIN=localhost
PUBLIC_URL=https://localhost

# PostgreSQL
POSTGRES_DB=arvix
POSTGRES_USER=arvix
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://arvix:changeme@postgres:5432/arvix

# Redis
REDIS_URL=redis://redis:6379/0

# LLM-провайдеры (роли моделей — в core/ai/roles.yaml, здесь только ключи)
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
