{
  "name": "Arvix",
  "short_name": "Arvix",
  "description": "Личный ментор: задачи, фокус, заметки, прогресс и разговор с Arvix.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0b10",
  "theme_color": "#0a0b10",
  "lang": "ru",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Чат с Arvix",
      "url": "/?tab=chat"
    },
    {
      "name": "Заметки",
      "url": "/?tab=notes"
    },
    {
      "name": "Сегодня",
      "url": "/?tab=today"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "video/*",
            "audio/*",
            "text/*",
            "application/zip",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "*/*"
          ]
        }
      ]
    }
  }
}
