[Unit]
Description=Arvix — Telegram-бот личного ментора
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="@PYTHON@" "@APP@/scripts/arvix_telegram.py"
Environment=PATH=@PATH@
Environment=PYTHONUNBUFFERED=1
# На сервере: токен подписки из `claude setup-token` (CLAUDE_CODE_OAUTH_TOKEN=…), права 600.
EnvironmentFile=-%h/.config/arvix/claude.env
Restart=always
RestartSec=15
TimeoutStopSec=30

[Install]
WantedBy=default.target
